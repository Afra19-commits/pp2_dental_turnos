<!DOCTYPE html>
<html>
<head>
    <title>Panel Admin - DentalTurnos</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <div class="container">
        <h1>Panel de Gestión Odontológica</h1>
        <a href="/logout" class="btn-logout">Cerrar Sesión</a>
        
        <h3>Agenda de Turnos</h3>
        <table>
            <thead>
                <tr>
                    <th style="width: 15%;">Fecha</th>
                    <th style="width: 15%;">Hora</th>
                    <th style="width: 20%;">Paciente</th>
                    <th style="width: 15%;">Tratamiento</th>
                    <th style="width: 15%;">Estado</th>
                    <th style="width: 20%;">Acción</th>
                </tr>
            </thead>
            <tbody>
                <% if (turnos.length > 0) { %>
                    <% turnos.forEach(t => { %>
                        <tr>
                            <td><%= t.fecha %></td>
                            <td><%= t.hora %></td>
                            <td><%= t.paciente_nombre %></td>
                            <td><%= t.tratamiento %></td>
                            <td>
                                <span class="estado-<%= t.estado %>">
                                    <%= t.estado.toUpperCase() %>
                                </span>
                            </td>
                            <td>
                                <form action="/cambiar-estado/<%= t.id %>" method="POST" style="display: flex; gap: 4px; margin: 0; align-items: center;">
                                    <select name="nuevo_estado" style="padding: 4px; font-size: 12px; margin: 0; width: auto;">
                                        <option value="pendiente" <%= t.estado === 'pendiente' ? 'selected' : '' %>>Pendiente</option>
                                        <option value="atendido" <%= t.estado === 'atendido' ? 'selected' : '' %>>Atendido</option>
                                        <option value="ausente" <%= t.estado === 'ausente' ? 'selected' : '' %>>Ausente</option>
                                    </select>
                                    <button type="submit" style="padding: 4px 8px; font-size: 12px; margin: 0; width: auto; background-color: #007bff; color: white; border-radius: 4px; border: none; cursor: pointer;">OK</button>
                                </form>
                            </td>
                        </tr>
                    <% }) %>
                <% } else { %>
                    <tr><td colspan="6" style="text-align: center;">No hay turnos reservados aún.</td></tr>
                <% } %>
            </tbody>
        </table>
    </div>
</body>
</html>